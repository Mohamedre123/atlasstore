# ============================================================
#  انسخ الملف ده لملف اسمه .env.local وحط فيه المفاتيح الحقيقية
#  على Vercel: Settings → Environment Variables
#  الخطوات بالتفصيل في README.md
# ============================================================


# ------------------------------------------------------------
#  1) إرسال إيميل الأوردر — Resend
#     من غيره مش هتوصلك أوردرات على السيرفر
# ------------------------------------------------------------

# المفتاح من resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# الإيميل اللي هيوصله إشعار كل أوردر (تقدر تحط أكتر من واحد بفاصلة)
ORDER_EMAIL_TO=iaomn8406@gmail.com

# المُرسِل. سيبه كده لحد ما تربط دومينك في Resend
ORDER_EMAIL_FROM=ATLAS Store <onboarding@resend.dev>


# ------------------------------------------------------------
#  2) تسجيل الدخول — Supabase
#     من Supabase → Project Settings → Data API
#     من غيرهم المتجر بيشتغل عادي بس من غير تسجيل دخول
# ------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
