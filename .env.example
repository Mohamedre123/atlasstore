# ============================================================
#  انسخ الملف ده لملف اسمه .env.local وحط فيه المفاتيح الحقيقية
#  ونفس القيم لازم تتحط في Vercel → Settings → Environment Variables
# ============================================================


# ------------------------------------------------------------
#  1) إرسال إيميل الأوردر — Resend
# ------------------------------------------------------------

# المفتاح من resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ⚠️ مهم جدًا:
# من غير توثيق دومين، Resend بيسمح بالإرسال لإيميل حساب Resend نفسه بس.
# لو حطيت إيميل تاني هترجعلك رسالة 403 والأوردر مش هيتبعت.
#
# عشان تبعت لأي إيميل: وثّق دومينك في resend.com/domains،
# وبعدين غيّر ORDER_EMAIL_FROM لـ: ATLASs Store <orders@yourdomain.com>
ORDER_EMAIL_TO=atlassstore36@gmail.com

ORDER_EMAIL_FROM=ATLASs Store <onboarding@resend.dev>


# ------------------------------------------------------------
#  2) تسجيل الدخول — Supabase
#     من Supabase → Project Settings → Data API
#     من غيرهم المتجر بيشتغل عادي بس من غير تسجيل دخول
# ------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
